{
  "name": "se-panfilov-profile-readme",
  "version": "0.2.8",
  "description": "Generate README.md with a daily Cyberpunk 2077 tarot card",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "build": "vite build",
    "readme": "npm run build && node dist/src/cli.js",
    "readme:dry-run": "npm run build && node dist/src/cli.js --dry-run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean:reinstall": "npm ci --ignore-scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gitleaks:staged": "node scripts/scan-secrets.mjs staged",
    "gitleaks:history": "node scripts/scan-secrets.mjs history",
    "gitleaks:files": "node scripts/scan-secrets.mjs files",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "lefthook validate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prettier:changed": "node scripts/format-changed.mjs",
    "pretty-quick": "node scripts/format-changed.mjs --staged",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
